<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>IDS for checking OIB 2 Table 1b - Building class 4</title>
        <copyright>TU Wien</copyright>
        <date>2024-06-06</date>
    </info>
    <specifications>
        <specification name="1.1 Load-bearing elements (Wall) in the top storey (except slabs and walls forming fire compartments)"
            ifcVersion="IFC4">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
                <partOf >
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDING</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>ZDB_BuildingData</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>BuildingClass</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>GK4</simpleValue>
                        </value>
                    </property>
                </partOf>
                <partOf>
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLOGICAL">
                        <propertySet>
                            <simpleValue>Pset_BuildingStoreyCommon</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>AboveGround</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>true</simpleValue>
                        </value>
                    </property>
                    <property dataType="IFCLENGTHMEASURE">
                        <propertySet>
                            <simpleValue>ZDB_BuildingStoreyData</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>EscapeLevel</simpleValue>
                        </baseName>
                    </property>
                </partOf>
                <property dataType="IFCBOOLEAN">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearing</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>true</simpleValue>
                    </value>
                </property>
                <property dataType="IFCBOOLEAN">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Compartmentation</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>false</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>FireRating</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="R 30" />
                            <xs:enumeration value="R 60" />
                            <xs:enumeration value="R 90" />
                            <xs:enumeration value="R 120" />
                            <xs:enumeration value="R 180" />
                            <xs:enumeration value="REI 30" />
                            <xs:enumeration value="REI 60" />
                            <xs:enumeration value="REI 90" />
                            <xs:enumeration value="REI 120" />
                            <xs:enumeration value="REI 180" />                            
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
