        <!--2. Partition walls are used to seperate different units-->
        <specification name="2.1 Partition walls in the top storey (excluding staircase walls)"
        ifcVersion="IFC4">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
                <partOf >
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDING</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>ZDB_BuildingData</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>BuildingClass</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>GK4</simpleValue>
                        </value>
                    </property>
                </partOf>
                <partOf>
                    <entity>
                        <name>
                            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLOGICAL">
                        <propertySet>
                            <simpleValue>Pset_BuildingStoreyCommon</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>AboveGround</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>true</simpleValue>
                        </value>
                    </property>
                    <property dataType="IFCLENGTHMEASURE">
                        <propertySet>
                            <simpleValue>ZDB_BuildingStoreyData</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>EscapeLevel</simpleValue>
                        </baseName>
                    </property>
                </partOf>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCLABEL">
                        <propertySet>
                            <simpleValue>ZDB_SpaceData</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>StaircaseType</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>OIB2Tab2ab</simpleValue>
                        </value>
                    </property>
                    <multiElementProcessing>noElementMayComply</multiElementProcessing>
                </partOf>
                <partOf relation="IFCRELSPACEBOUNDARY">
                    <entity>
                        <name>
                            <simpleValue>IFCSPACE</simpleValue>
                        </name>
                    </entity>
