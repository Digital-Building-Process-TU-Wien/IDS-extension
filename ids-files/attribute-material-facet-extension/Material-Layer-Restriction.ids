<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>IDS for testing the material of a wall</title>
        <copyright>TU Wien</copyright>
        <date>2026-08-11</date>
    </info>
    <specifications>
        <specification name="Specification for testing an IfcMaterialLayerSet (Entity facet)" ifcVersion="IFC4">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material>
                    <value>
                        <simpleValue>D0077</simpleValue>
                    </value>
                    <entity>
                        <name>
                            <simpleValue>IFCMATERIALLAYERSET</simpleValue>
                        </name>
                    </entity>
                </material>
            </requirements>
        </specification>
        <specification name="Specification for testing an IfcMaterialLayer (Attribute facet)" ifcVersion="IFC4">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material>
                    <value>
                        <simpleValue>Cover leftside 1st layer</simpleValue>
                    </value>
                    <entity>
                        <name>
                            <simpleValue>IFCMATERIALLAYER</simpleValue>
                        </name>
                    </entity>
                    <attribute>
                        <name>
                            <simpleValue>LayerThickness</simpleValue>
                        </name>
                        <value>
                            <simpleValue>0.022</simpleValue>
                        </value>
                    </attribute>
                </material>
            </requirements>
        </specification>
        <specification name="Specification for testing an IfcMaterial (Property facet)" ifcVersion="IFC4">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material>
                    <value>
                        <simpleValue>Wood cladding horizontal, closed</simpleValue>
                    </value>
                    <entity>
                        <name>
                            <simpleValue>IFCMATERIAL</simpleValue>
                        </name>
                    </entity>
                    <property dataType="IFCMASSDENSITYMEASURE">
                        <propertySet>
                            <simpleValue>Pset_MaterialCommon</simpleValue>
                        </propertySet>
                        <baseName>
                            <simpleValue>MassDensity</simpleValue>
                        </baseName>
                        <value>
                            <simpleValue>490</simpleValue>
                        </value>
                    </property>
                </material>
            </requirements>
        </specification>
        <specification name="Specification for testing a IfcMaterialLayerSet with an Attribute facet" ifcVersion="IFC4">
            <applicability>
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <material>
                    <value>
                        <simpleValue>D0077</simpleValue>
                    </value>
                    <entity>
                        <name>
                            <simpleValue>IFCMATERIALLAYERSET</simpleValue>
                        </name>
                    </entity>
                    <attribute>
                        <name>
                            <simpleValue>MaterialLayers</simpleValue>
                        </name>
                        <entity>
                            <name>
                                <simpleValue>IFCMATERIALLAYER</simpleValue>
                            </name>
                        </entity>
                        <attribute>
                            <name>
                                <simpleValue>Name</simpleValue>
                            </name>
                            <value>
                                <simpleValue>Cover leftside 1st layer</simpleValue>
                            </value>
                        </attribute>
                        <attribute>
                            <name>
                                <simpleValue>LayerThickness</simpleValue>
                            </name>
                            <value>
                                <simpleValue>0.022</simpleValue>
                            </value>
                        </attribute>
                        <attribute>
                            <name>
                                <simpleValue>Material</simpleValue>
                            </name>
                            <entity>
                                <name>
                                    <simpleValue>IFCMATERIAL</simpleValue>
                                </name>
                            </entity>
                            <attribute>
                                <name>
                                    <simpleValue>Name</simpleValue>
                                </name>
                                <value>
                                    <simpleValue>Wood cladding horizontal, closed</simpleValue>
                                </value>
                            </attribute>
                            <property dataType="IFCMASSDENSITYMEASURE">
                                <propertySet>
                                    <simpleValue>Pset_MaterialCommon</simpleValue>
                                </propertySet>
                                <baseName>
                                    <simpleValue>MassDensity</simpleValue>
                                </baseName>
                                <value>
                                    <simpleValue>490</simpleValue>
                                </value>
                            </property>
                        </attribute>
                    </attribute>
                </material>
            </requirements>
        </specification>
    </specifications>
</ids>